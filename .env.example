# --- Betrieb ---------------------------------------------------------------
# Signiert das Session-Cookie. MUSS in Produktion gesetzt und geheim sein.
# Erzeugen mit:  python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SITZUNG_SCHLUESSEL=bitte-ersetzen-nicht-in-produktion-verwenden

# Setzt das Secure-Flag am Cookie. Nur fuer lokale Entwicklung auf false.
# In Produktion immer true - die App laeuft hinter HTTPS (D-10).
HTTPS_AKTIV=true

# --- Daten -----------------------------------------------------------------
DATENBANK_PFAD=daten/tagesberichte.db
KONFIGURATION_VERZEICHNIS=konfiguration
EXPORT_VERZEICHNIS=export

# --- Anbieter (D-09) -------------------------------------------------------
# attrappe | whisper_api | faster_whisper
TRANSKRIPTION_ANBIETER=attrappe
TRANSKRIPTION_API_SCHLUESSEL=
TRANSKRIPTION_BASIS_URL=

# attrappe | claude
STRUKTURIERUNG_ANBIETER=attrappe
ANTHROPIC_API_KEY=

# --- Protokollierung -------------------------------------------------------
PROTOKOLL_STUFE=INFO

# --- Erstinbetriebnahme ----------------------------------------------------
# 1. Diese Datei nach .env kopieren und SITZUNG_SCHLUESSEL ersetzen
# 2. Projekt eintragen:
#      python3 -m app.cli projekt-anlegen "Musterstraße 12" --mappe /pfad/mappe.xlsx
# 3. Konten anlegen (Einmalpasswort wird einmalig ausgegeben):
#      python3 -m app.cli benutzer-anlegen ahrens \
#          --anzeigename "M. Ahrens" --excel-name Ahrens --regelbeginn 07:00
#    --excel-name muss wortgleich in MitarbeiterListe der Mappe stehen (D-05).
